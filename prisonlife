RunService:BindToRenderStep(
    "UnnamedEnchantmentsSpeedwalk",
    Enum.RenderPriority.Character.Value + 1,
    function(dt)
        if Killed then return end
        if not (Toggles.SpeedwalkEnabled and Toggles.SpeedwalkEnabled.Value) then return end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local cam = ws.CurrentCamera
        if not hum or not hrp or not cam then return end
        local mode = GetSpeedMode()
        local speed = GetConfiguredSpeed()
        if mode == "slippery" then
            ApplySlipperySpeed(hum)
            return
        end
        hum.WalkSpeed = math.max(hum.WalkSpeed, 16)
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude <= 0.001 then
            hrp.AssemblyLinearVelocity = Vector3.zero
            return
        end
        local horizontal = Vector3.new(moveDir.X, 0, moveDir.Z)
        if horizontal.Magnitude <= 0.001 then
            hrp.AssemblyLinearVelocity = Vector3.zero
            return
        end
        horizontal = horizontal.Unit
        local step = horizontal * speed * math.max(dt, 1 / 240)
        hrp.CFrame = hrp.CFrame + step
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
)

