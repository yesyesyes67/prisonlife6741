AutoBuy.GetShopLocations = function(force)
    local now = tick()
    if not (force or not ShopCache.locations or (now - ShopCache.lastUpdate >= ShopCache.updateInterval)) then
        return ShopCache.locations
    end
    local out = {}
    local seen = {}
    local names = {"Pads","Shops","BuyPads","Shop","Buy","Store","Dealers","GunDealer","GunShop","Items","Purchase"}
    local MAP = ws:FindFirstChild("MAP")
    if MAP then
        for _, n in ipairs(names) do
            local v = MAP:FindFirstChild(n)
            if v and not seen[v] then table.insert(out, v) seen[v] = true end
        end
    end
    for _, n in ipairs(names) do
        local v = ws:FindFirstChild(n)
        if v and not seen[v] then table.insert(out, v) seen[v] = true end
    end
    if #out == 0 then
        for _, v in pairs(ws:GetChildren()) do
            if (v:IsA("Folder") or v:IsA("Model")) and not seen[v] then
                local ln = v.Name:lower()
                if ln:find("pad") or ln:find("shop") or ln:find("buy") or ln:find("dealer") then
                    table.insert(out, v)
                    seen[v] = true
                end
            end
        end
    end
    ShopCache.locations = out
    ShopCache.lastUpdate = now
    return out
end

AutoBuy.FindItem = function(name)
    if ItemCache[name] then
        local c = ItemCache[name]
        if c.item and c.item.Parent and c.clickDetector and c.clickDetector.Parent then
            return c.item, c.clickDetector
        end
        ItemCache[name] = nil
    end
    local locs = AutoBuy.GetShopLocations()
    local stripped = name:gsub("%[", ""):gsub("%]", "")
    for _, loc in ipairs(locs) do
        local direct = loc:FindFirstChild(name)
        if direct then
            local cd = direct:FindFirstChildOfClass("ClickDetector")
            if cd then
                ItemCache[name] = {item = direct, clickDetector = cd}
                return direct, cd
            end
        end
        for _, child in pairs(loc:GetChildren()) do
            if child.Name == name or child.Name:find(stripped) then
                local cd = child:FindFirstChildOfClass("ClickDetector")
                if cd then
                    ItemCache[name] = {item = child, clickDetector = cd}
                    return child, cd
                end
            end
        end
    end
    return nil, nil
end

AutoBuy.HasItem = function(name)
    local lp = name:lower()
    local s1 = lp:gsub("%[", ""):gsub("%]", "")
    local s2 = s1:gsub(" ", "")
    local function scan(container)
        for _, c in pairs(container:GetChildren()) do
            if c:IsA("Tool") then
                local n = c.Name:lower():gsub(" ", "")
                if n:find(s2) or s2:find(n) then return true end
            end
        end
        return false
    end
    if scan(LocalPlayer.Backpack) then return true end
    if LocalPlayer.Character and scan(LocalPlayer.Character) then return true end
    return false
end

AutoBuy.GetBackpackCount = function()
    local n = 0
    for _, c in pairs(LocalPlayer.Backpack:GetChildren()) do
        if c:IsA("Tool") then n = n + 1 end
    end
    if LocalPlayer.Character then
        for _, c in pairs(LocalPlayer.Character:GetChildren()) do
            if c:IsA("Tool") then n = n + 1 end
        end
    end
    return n
end

AutoBuy.BuyItem = function(cd)
    if cd then return pcall(function() fireclickdetector(cd) end) end
    return false
end

AutoBuy.BuyItemVerified = function(name, attempts)
    attempts = attempts or 5
    if AutoBuy.HasItem(name) then return true, "already_owned" end
    local _, cd = AutoBuy.FindItem(name)
    if not cd then return false, "not_found" end
    local before = AutoBuy.GetBackpackCount()
    for i = 1, attempts do
        AutoBuy.BuyItem(cd)
        task.wait(0.15)
        if AutoBuy.HasItem(name) then return true, "purchased" end
        if AutoBuy.GetBackpackCount() > before then return true, "purchased" end
        if i < attempts then task.wait(0.1) end
    end
    return false, "failed"
end

AutoBuy.BuyArmor = function()
    if DaHood.getarmor(LocalPlayer) < AutoBuyState.armorthreshold then
        for _, name in ipairs(ArmorShopItems) do
            local _, cd = AutoBuy.FindItem(name)
            if cd then
                local before = DaHood.getarmor(LocalPlayer)
                for _ = 1, 3 do
                    AutoBuy.BuyItem(cd)
                    task.wait(0.15)
                    if DaHood.getarmor(LocalPlayer) > before then return true end
                end
                return false
            end
        end
    end
    return false
end

AutoBuy.BuySelected = function()
    if AutoBuyState.hasboughtthislife then return end
    AutoBuyState.boughtitems = {}
    task.spawn(function()
        local bought, failed = 0, 0
        local armorBefore = DaHood.getarmor(LocalPlayer)
        if AutoBuy.BuyArmor() then
            task.wait(0.2)
            if DaHood.getarmor(LocalPlayer) > armorBefore then bought += 1 end
        end
        local list = {}
        for k, v in pairs(AutoBuyState.selecteditems) do
            if v and not AutoBuy.HasItem(k) then table.insert(list, k) end
        end
        for i, name in ipairs(list) do
            if AutoBuyState.boughtitems[name] then continue end
            local ok, why = AutoBuy.BuyItemVerified(name, 5)
            if not ok then
                failed += 1
                warn("[AutoBuy] Failed to buy: " .. name .. " (" .. why .. ")")
            else
                AutoBuyState.boughtitems[name] = true
                if why == "purchased" then bought += 1 end
            end
            if i < #list then task.wait(0.1) end
        end
        if bought > 0 or failed > 0 then
            Library:Notify(string.format("Bought %d items, %d failed", bought, failed), 3)
        end
    end)
    AutoBuyState.hasboughtthislife = true
end

