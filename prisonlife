local walkSpeedGuardConnection = nil
local boundHumanoid = nil

local function GetSpeedMode()
    local mode = Options.SpeedwalkMode and Options.SpeedwalkMode.Value
    return mode == "cframe" and "cframe" or "slippery"
end

local function GetConfiguredSpeed()
    return math.max(1, Options.WalkSpeedValue and Options.WalkSpeedValue.Value or 100)
end

local function ApplySlipperySpeed(hum)
    if not hum or not hum.Parent then return end

    if Toggles.NoSlowdownEnabled and Toggles.NoSlowdownEnabled.Value then
        if hum.WalkSpeed < 16 then
            hum.WalkSpeed = 16
        end
    end

    if not (Toggles.SpeedwalkEnabled and Toggles.SpeedwalkEnabled.Value) then return end
    if GetSpeedMode() ~= "slippery" then return end
    local target = GetConfiguredSpeed()
    if hum.WalkSpeed ~= target then hum.WalkSpeed = target end
end

local function BindWalkSpeedGuard(char)
    if walkSpeedGuardConnection then
        walkSpeedGuardConnection:Disconnect()
        walkSpeedGuardConnection = nil
    end
    boundHumanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not boundHumanoid then return end
    ApplySlipperySpeed(boundHumanoid)
    walkSpeedGuardConnection = boundHumanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if Killed then return end
        ApplySlipperySpeed(boundHumanoid)
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    if Killed then return end
    task.defer(function() BindWalkSpeedGuard(char) end)
end)

