local AnimationEnabled = false
local OriginalAnimationIds = {}

local function CaptureOriginalAnimations(animate)
    if next(OriginalAnimationIds) ~= nil then return end
    for animType, _ in pairs(ANIMATIONS) do
        local folder = animate:FindFirstChild(animType)
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("Animation") then
                    OriginalAnimationIds[child] = child.AnimationId
                end
            end
        end
    end
end

local function ApplyAnimations(character)
    if not character then return end
    local animate = character:FindFirstChild("Animate") or character:WaitForChild("Animate", 5)
    if not animate then return end
    if AnimationEnabled then
        CaptureOriginalAnimations(animate)
        for animType, animId in pairs(ANIMATIONS) do
            local folder = animate:FindFirstChild(animType)
            if folder then
                for _, child in ipairs(folder:GetChildren()) do
                    if child:IsA("Animation") then child.AnimationId = animId end
                end
            end
        end
    else
        for anim, originalId in pairs(OriginalAnimationIds) do
            if anim and anim.Parent then anim.AnimationId = originalId end
        end
        OriginalAnimationIds = {}
    end
end

