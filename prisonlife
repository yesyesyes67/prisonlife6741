local HeadlessEnabled = false
local OriginalHeadTransparency = nil
local OriginalDecalTransparencies = {}

local function ApplyHeadless(character)
    if not character then return end
    local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 5)
    if not head then return end
    if HeadlessEnabled then
        if OriginalHeadTransparency == nil then
            OriginalHeadTransparency = head.Transparency
        end
        head.Transparency = 1
        head.CanCollide = false
        for _, part in ipairs(head:GetChildren()) do
            if part:IsA("Decal") or part:IsA("Texture") then
                if OriginalDecalTransparencies[part] == nil then
                    OriginalDecalTransparencies[part] = part.Transparency
                end
                part.Transparency = 1
            end
        end
    else
        if OriginalHeadTransparency ~= nil then
            head.Transparency = OriginalHeadTransparency
            OriginalHeadTransparency = nil
        end
        head.CanCollide = true
        for part, original in pairs(OriginalDecalTransparencies) do
            if part and part.Parent then part.Transparency = original end
        end
        OriginalDecalTransparencies = {}
