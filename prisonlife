local AppearanceState = {
    enabled = false,
    userId = 5683146469,
}

local function ApplyAppearance(targetUserId)
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local success, description = pcall(function()
        return Players:GetHumanoidDescriptionFromUserIdAsync(targetUserId)
    end)

    if success and description then
        pcall(function()
            if humanoid.ApplyDescriptionClientServer then
                humanoid:ApplyDescriptionClientServer(description)
            else
                humanoid:ApplyDescription(description)
            end
        end)
    end

    local ok2, appearance = pcall(function()
        return Players:GetCharacterAppearanceAsync(targetUserId)
    end)

    if not ok2 or not appearance then return end

    for _, v in ipairs(character:GetChildren()) do
        if v:IsA("Shirt")
            or v:IsA("Pants")
            or v:IsA("ShirtGraphic")
            or v:IsA("Accessory") then
            v:Destroy()
        end
    end

    for _, v in ipairs(appearance:GetChildren()) do
        if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") then
            v:Clone().Parent = character
        end
    end

    for _, v in ipairs(appearance:GetChildren()) do
        if v:IsA("Accessory") then
            pcall(function()
                humanoid:AddAccessory(v:Clone())
            end)
        end
    end

    local head = character:FindFirstChild("Head")
    if head and appearance:FindFirstChild("face") then
        local oldFace = head:FindFirstChild("face")
        if oldFace then oldFace:Destroy() end
        appearance.face:Clone().Parent = head
    end

    appearance:Destroy()
end

local function RunCharSwap()
    local uid = AppearanceState.userId
    task.spawn(function()
        task.wait(0.1)
        ApplyAppearance(uid)
    end)
end

