local SemiDesyncEnabled = false
local SemiDesyncInitConn = nil
local SemiDesyncRoot = nil
local SEMI_VEL_MAX = (128 ^ 2)
local SEMI_TIME_RELEASE = 0.015
local SEMI_FALLBACK_CHOKE = 0.105

local statPing = Stats.PerformanceStats.Ping

local function GetPingSeconds()
    local ok, val = pcall(function() return statPing:GetValue() end)
    if ok and type(val) == "number" and val > 0 then
        return math.ceil(val) / 1000
    end
    return SEMI_FALLBACK_CHOKE
end

local function SemiSleep()
    if Killed then return end
    if not SemiDesyncRoot or not SemiDesyncRoot.Parent then return end
    pcall(function() sethiddenproperty(SemiDesyncRoot, "NetworkIsSleeping", true) end)
end

local function SemiInitTick()
    if Killed then return end
    if not SemiDesyncRoot or not SemiDesyncRoot.Parent then return end
    local root = SemiDesyncRoot
    local rootVel = root.Velocity
    local rootAng = math.random(-180, 180)
    local X = math.random(-SEMI_VEL_MAX, SEMI_VEL_MAX)
    local Y = math.random(0, SEMI_VEL_MAX)
    local Z = math.random(-SEMI_VEL_MAX, SEMI_VEL_MAX)
    root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(rootAng), 0)
    root.Velocity = Vector3.new(X, -Y, Z)
    RunService.RenderStepped:Wait()
    root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(-rootAng), 0)
    root.Velocity = rootVel
end

local function SemiChokeLoop()
    while SemiDesyncEnabled and not Killed do
        local a = RunService.Heartbeat:Connect(SemiSleep)
        local b = RunService.RenderStepped:Connect(SemiSleep)
        task.wait(GetPingSeconds())
        a:Disconnect()
        b:Disconnect()
        task.wait(SEMI_TIME_RELEASE)
    end
end

local function SemiDesyncStart()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        task.defer(function()
            local c = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            SemiDesyncRoot = c:WaitForChild("HumanoidRootPart", 5)
        end)
    else
        SemiDesyncRoot = hrp
    end
    if SemiDesyncInitConn then SemiDesyncInitConn:Disconnect() end
    SemiDesyncInitConn = RunService.Heartbeat:Connect(SemiInitTick)
    task.spawn(SemiChokeLoop)
end

local function SemiDesyncStop()
    SemiDesyncEnabled = false
    if SemiDesyncInitConn then SemiDesyncInitConn:Disconnect() SemiDesyncInitConn = nil end
    if SemiDesyncRoot and SemiDesyncRoot.Parent then
        pcall(function() sethiddenproperty(SemiDesyncRoot, "NetworkIsSleeping", false) end)
    end
    SemiDesyncRoot = nil
end

