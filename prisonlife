local StompState = {
    autoActive = false, autoTargetOnly = false,
    autoLoop = nil, autoOriginalCFrame = nil, autoTeleported = false,
    knockActive = false,
}

local function StompFire()
    pcall(function() ReplicatedStorage.MainEvent:FireServer("Stomp") end)
    pcall(function() ReplicatedStorage.MAINEVENT:FireServer("STOMP") end)
end

local function AutoStompStart()
    if StompState.autoLoop then return end
    StompState.autoLoop = RunService.Heartbeat:Connect(function()
        if Killed then return end
        if not StompState.autoActive then return end
        if not Utils.hascharacter(LocalPlayer) then return end
        local hrp = LocalPlayer.Character.HumanoidRootPart
        if not StompState.autoTargetOnly then
            StompFire()
            return
        end
        if not (StickyTarget and StickyTarget.Parent) then
            if StompState.autoTeleported and StompState.autoOriginalCFrame then
                hrp.CFrame = StompState.autoOriginalCFrame
                hrp.AssemblyLinearVelocity = Vector3.zero
                StompState.autoTeleported = false
                StompState.autoOriginalCFrame = nil
            end
            return
        end
        local targetPlr = Players:GetPlayerFromCharacter(StickyTarget.Parent)
        if not (targetPlr and (DaHood.isknocked(targetPlr) or DaHood.isdead(targetPlr))) then
            if StompState.autoTeleported and StompState.autoOriginalCFrame then
                hrp.CFrame = StompState.autoOriginalCFrame
                hrp.AssemblyLinearVelocity = Vector3.zero
                StompState.autoTeleported = false
                StompState.autoOriginalCFrame = nil
            end
            return
        end
        if not StompState.autoTeleported then
            StompState.autoOriginalCFrame = hrp.CFrame
            StompState.autoTeleported = true
        end
        local targetHrp = StickyTarget.Parent:FindFirstChild("HumanoidRootPart")
        if targetHrp then
            hrp.CFrame = targetHrp.CFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
        StompFire()
    end)
end

local function AutoStompStop()
    if StompState.autoLoop then
        StompState.autoLoop:Disconnect()
        StompState.autoLoop = nil
    end
    if StompState.autoTeleported and StompState.autoOriginalCFrame and Utils.hascharacter(LocalPlayer) then
        LocalPlayer.Character.HumanoidRootPart.CFrame = StompState.autoOriginalCFrame
        LocalPlayer.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
    end
    StompState.autoTeleported = false
    StompState.autoOriginalCFrame = nil
end

local function FindNearbyKnocked()
    local char = LocalPlayer.Character
    if not (char and char:FindFirstChild("HumanoidRootPart")) then return nil, nil end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if not plr.Character then continue end
        if DaHood.isdead(plr) then continue end
        if not DaHood.isknocked(plr) then continue end
        local m = ws:FindFirstChild(plr.Name)
        if m and m:FindFirstChild("HB") then
            return m.HB, plr
        end
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            return hrp, plr
        end
    end
    return nil, nil
end

local function KnockStompLoop()
    while StompState.knockActive and not Killed do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local myHrp = char.HumanoidRootPart
            local part, targetPlr = FindNearbyKnocked()

            if part and targetPlr then
                local original = myHrp.CFrame
                while StompState.knockActive and DaHood.isknocked(targetPlr) and not Killed do
                    if part and part.Parent then
                        myHrp.CFrame = CFrame.new(part.Position.X, part.Position.Y, part.Position.Z)
                        myHrp.AssemblyLinearVelocity = Vector3.zero
                    end
                    StompFire()
                    task.wait(0.05)
                end
                myHrp.CFrame = original
                myHrp.AssemblyLinearVelocity = Vector3.zero
            end
        end
        task.wait(0.3)
    end
end

