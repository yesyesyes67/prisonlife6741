local function IsKnocked(hum)
    if not hum then return false end
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Physics then return true end
    if state == Enum.HumanoidStateType.PlatformStanding then return true end
    if hum.PlatformStand then return true end
    if hum.Health <= 0 then return true end
    return false
end

local PRED_SCALE = 0.01

local function ApplyPrediction(part, predX, predY)
    local vel = part.AssemblyLinearVelocity
    return Vector3.new(
        vel.X * predX * PRED_SCALE,
        vel.Y * predY * PRED_SCALE,
        vel.Z * predX * PRED_SCALE
    )
end

RunService.RenderStepped:Connect(function(dt)
    if Killed then return end
    if not (Toggles.AimEnabled and Toggles.AimEnabled.Value and Options.AimbotKey:GetState()) then
        StickyTarget = nil
        return
    end

    Camera = ws.CurrentCamera
    if not Camera then return end

    local predictionOn = Toggles.UsePrediction.Value
    local PredictionX = predictionOn and (Options.PredictionX.Value or 0) or 0
    local PredictionY = predictionOn and (Options.PredictionY.Value or 0) or 0
    local SmoothnessSlider = Toggles.UseSmoothness.Value and (Options.Smoothness.Value or 1) or 1
    local baseAlpha = 1 / math.max(1, (SmoothnessSlider * 2) - 1)
    local SmoothnessAlpha = 1 - (1 - baseAlpha) ^ (math.max(dt, 1 / 240) * 60)
    if SmoothnessAlpha > 1 then SmoothnessAlpha = 1 end
    local knockCheck = Toggles.KnockCheck.Value
    local mousePos = uis:GetMouseLocation()

    local function IsValidTarget(Part)
        if not Part or not Part.Parent then return false end
        local Character = Part.Parent
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if not Humanoid or Humanoid.Health <= 0 then return false end
        local Player = Players:GetPlayerFromCharacter(Character)
        if not Player or Player == LocalPlayer then return false end
        if TeamCheck and Player.Team and LocalPlayer.Team and Player.Team == LocalPlayer.Team then
            return false
        end
        if knockCheck and IsKnocked(Humanoid) then return false end
        return true
    end

    if StickyTarget and not IsValidTarget(StickyTarget) then StickyTarget = nil end

    if not StickyTarget then
        local Best, BestDist = nil, math.huge
        for _, Player in pairs(Players:GetPlayers()) do
            if Player ~= LocalPlayer and Player.Character then
                local Part = Player.Character:FindFirstChild(ResolveAimPart(AimPart))
                if Part and IsValidTarget(Part) then
                    local offset = ApplyPrediction(Part, PredictionX, PredictionY)
                    local Vector, OnScreen = Camera:WorldToViewportPoint(Part.Position + offset)
                    if OnScreen then
                        local Dist = (Vector2.new(mousePos.X, mousePos.Y) - Vector2.new(Vector.X, Vector.Y)).Magnitude
                        if Dist < BestDist then BestDist = Dist Best = Part end
                    end
                end
            end
        end
        StickyTarget = Best
    end

    if StickyTarget then
        local offset = ApplyPrediction(StickyTarget, PredictionX, PredictionY)
        local TargetPos = StickyTarget.Position + offset
        local currentCF = Camera.CFrame
        local goalCF = CFrame.new(currentCF.Position, TargetPos)
        suppressCameraWrite = true
        Camera.CFrame = SmoothnessAlpha >= 1 and goalCF or currentCF:Lerp(goalCF, SmoothnessAlpha)
        suppressCameraWrite = false
        if NoRecoilEnabled then
            lastCleanCF = Camera.CFrame
        end
    end
end)

