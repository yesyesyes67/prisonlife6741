local function HealthGradient(pct)
    if pct >= 0.75 then return Color3.fromRGB(0, 255, 0)
    elseif pct >= 0.5 then return Color3.fromRGB(255, 255, 0)
    elseif pct >= 0.25 then return Color3.fromRGB(255, 170, 0)
    else return Color3.fromRGB(255, 0, 0) end
end

