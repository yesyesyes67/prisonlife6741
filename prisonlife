local StrafeAngle = 0

local function GetStrafeTarget()
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end
    local teamCheck = Toggles.StrafeTeamCheck and Toggles.StrafeTeamCheck.Value
    local mode = Options.StrafeTargetMode and Options.StrafeTargetMode.Value or "closest"

    if mode == "silent aim" then
        if CurrentSilentAimChar and CurrentSilentAimChar.Parent then
            local hrp = CurrentSilentAimChar:FindFirstChild("HumanoidRootPart")
            local hum = CurrentSilentAimChar:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                if not (teamCheck and CurrentSilentAimPlayer and CurrentSilentAimPlayer.Team
                    and LocalPlayer.Team and CurrentSilentAimPlayer.Team == LocalPlayer.Team) then
                    return hrp
                end
            end
        end
        return nil
    end

    if mode == "aimbot" then
        if StickyTarget and StickyTarget.Parent then
            local char = StickyTarget.Parent
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local plr = Players:GetPlayerFromCharacter(char)
                if not (teamCheck and plr and plr.Team and LocalPlayer.Team
                    and plr.Team == LocalPlayer.Team) then
                    return hrp
                end
            end
        end
        return nil
    end

    local best = nil
    local bestDist = math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then continue end
        if teamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
            continue
        end
        local dist = (hrp.Position - myHrp.Position).Magnitude
        if dist < bestDist then
            bestDist = dist
            best = hrp
        end
    end
    return best
end

