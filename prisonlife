local CachedTarget = nil

local function IsKnockedSilent(hum)
    if not hum then return false end
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Physics then return true end
    if state == Enum.HumanoidStateType.PlatformStanding then return true end
    if hum.PlatformStand then return true end
    if hum.Health <= 0 then return true end
    return false
end

local function SilentAimActive()
    if Killed then return false end
    if not (Toggles.SilentAimEnabled and Toggles.SilentAimEnabled.Value) then return false end
    if Toggles.SilentAimSync and Toggles.SilentAimSync.Value then
        return StickyTarget ~= nil
    end
    return Options.SilentAimKey:GetState()
end

local function ResolveSilentTarget()
    local cam = ws.CurrentCamera
    if not cam then return nil end
    local mouse = LocalPlayer:GetMouse()
    local mousePos = Vector2.new(mouse.X, mouse.Y)
    local fov = Options.SilentAimFov.Value or 435
    local partName = Options.SilentAimPart.Value or "head"
    local teamCheck = Toggles.SilentAimTeamCheck.Value
    local knockCheck = Toggles.SilentAimKnockCheck.Value
    local wallCheck = Toggles.SilentAimWallCheck.Value
    local predOn = Toggles.SilentAimPrediction.Value
    local predX = predOn and (Options.SilentAimPredX.Value or 0) or 0
    local predY = predOn and (Options.SilentAimPredY.Value or 0) or 0
    local ignoreFov = Toggles.SilentAimIgnoreFov and Toggles.SilentAimIgnoreFov.Value
    local sync = Toggles.SilentAimSync and Toggles.SilentAimSync.Value

    if sync then
        if not StickyTarget or not StickyTarget.Parent then
            CurrentSilentAimChar = nil
            CurrentSilentAimPlayer = nil
            return nil
        end

        local char = StickyTarget.Parent
        local hum = char:FindFirstChildOfClass("Humanoid")
        local part = char:FindFirstChild(ResolveAimPart(partName))
        if not hum or not part or hum.Health <= 0 then
            CurrentSilentAimChar = nil
            CurrentSilentAimPlayer = nil
            return nil
        end

        local plr = Players:GetPlayerFromCharacter(char)
        if not plr or plr == LocalPlayer then
            CurrentSilentAimChar = nil
            CurrentSilentAimPlayer = nil
            return nil
        end

        if teamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
            CurrentSilentAimChar = nil
            CurrentSilentAimPlayer = nil
            return nil
        end
        if knockCheck and IsKnockedSilent(hum) then
            CurrentSilentAimChar = nil
            CurrentSilentAimPlayer = nil
            return nil
        end

        local vel = part.AssemblyLinearVelocity
        local offset = Vector3.new(
            vel.X * predX * PRED_SCALE,
            vel.Y * predY * PRED_SCALE,
            vel.Z * predX * PRED_SCALE
        )

        CurrentSilentAimChar = char
        CurrentSilentAimPlayer = plr
        return part.Position + offset
    end

    if ignoreFov and CurrentSilentAimChar and CurrentSilentAimChar.Parent then
        local hum = CurrentSilentAimChar:FindFirstChildOfClass("Humanoid")
        local part = CurrentSilentAimChar:FindFirstChild(ResolveAimPart(partName))
        if hum and part and hum.Health > 0 then
            local plr = Players:GetPlayerFromCharacter(CurrentSilentAimChar)
            local valid = plr and plr ~= LocalPlayer

            if valid and teamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
                valid = false
            end
            if valid and knockCheck and IsKnockedSilent(hum) then
                valid = false
            end
            if valid and wallCheck then
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {LocalPlayer.Character}
                local hit = ws:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, rp)
                if hit and hit.Instance and not hit.Instance:IsDescendantOf(CurrentSilentAimChar) then
                    valid = false
                end
            end

            if valid then
                local vel = part.AssemblyLinearVelocity
                local offset = Vector3.new(
                    vel.X * predX * PRED_SCALE,
                    vel.Y * predY * PRED_SCALE,
                    vel.Z * predX * PRED_SCALE
                )
                CurrentSilentAimPlayer = plr
                return part.Position + offset
            end
        end
        CurrentSilentAimChar = nil
        CurrentSilentAimPlayer = nil
    end

    local best, bestDist, bestChar, bestPlayer = nil, math.huge, nil, nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local part = char:FindFirstChild(ResolveAimPart(partName))
            if hum and part and hum.Health > 0 then
                local pass = true
                if teamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
                    pass = false
                end
                if knockCheck and IsKnockedSilent(hum) then pass = false end
                if pass then
                    local vel = part.AssemblyLinearVelocity
                    local offset = Vector3.new(
                        vel.X * predX * PRED_SCALE,
                        vel.Y * predY * PRED_SCALE,
                        vel.Z * predX * PRED_SCALE
                    )
                    local worldPos = part.Position + offset
                    local screenPos, onScreen = cam:WorldToViewportPoint(worldPos)
                    if onScreen and screenPos.Z > 0 then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist <= fov and dist < bestDist then
                            if wallCheck then
                                local rp = RaycastParams.new()
                                rp.FilterType = Enum.RaycastFilterType.Exclude
                                rp.FilterDescendantsInstances = {LocalPlayer.Character}
                                local hit = ws:Raycast(cam.CFrame.Position, worldPos - cam.CFrame.Position, rp)
                                if not hit or not hit.Instance or hit.Instance:IsDescendantOf(char) then
                                    bestDist = dist best = worldPos bestChar = char bestPlayer = plr
                                end
                            else
                                bestDist = dist best = worldPos bestChar = char bestPlayer = plr
                            end
                        end
                    end
                end
            end
        end
    end
    CurrentSilentAimChar = bestChar
    CurrentSilentAimPlayer = bestPlayer
    return best
end

RunService.RenderStepped:Connect(function()
    if Killed then return end
    if SilentAimActive() then
        CachedTarget = ResolveSilentTarget()
    else
        CachedTarget = nil
        CurrentSilentAimChar = nil
        CurrentSilentAimPlayer = nil
    end
    if Toggles.SilentAimEnabled and Toggles.SilentAimEnabled.Value
        and Toggles.SilentAimDrawFov and Toggles.SilentAimDrawFov.Value then
