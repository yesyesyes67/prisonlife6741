local function AntiLockUpdate()
    if Killed then return end
    if not AntiLockState.enabled then return end
    if not (Options.AntiLockKey and Options.AntiLockKey:GetState()) then return end
    if not Utils.hascharacter(LocalPlayer) then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local mode = AntiLockState.mode
    if mode == "Jitter" then
        local ang = math.random(-180, 180)
        hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(ang), 0)
    elseif mode == "Reverse" then
        if StickyTarget and StickyTarget.Parent then
            local pos = StickyTarget.Position
            hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(pos.X, hrp.Position.Y, pos.Z))
                * CFrame.Angles(0, math.rad(180), 0)
        end
    elseif mode == "Side" then
        if StickyTarget and StickyTarget.Parent then
            local pos = StickyTarget.Position
            hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(pos.X, hrp.Position.Y, pos.Z))
                * CFrame.Angles(0, math.rad(90), 0)
        end
    end
end

local VoidHideSavedCFrame = nil
local VoidHideSpamConnection = nil
local VoidHideLastTeleport = 0
local VOID_SPAM_INTERVAL = 0.1

local function VoidHideRandomOffset()
    local s = function() return math.random() > 0.5 and 1 or -1 end
    return Vector3.new(
        s() * math.random(100000, 200000),
        math.random(100000, 200000),
        s() * math.random(100000, 200000)
    )
end

local function VoidHideTeleport()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not VoidHideSavedCFrame then VoidHideSavedCFrame = hrp.CFrame end
    hrp.Anchored = true
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(VoidHideSavedCFrame.Position + VoidHideRandomOffset())
end

local function VoidHideRestore()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and VoidHideSavedCFrame then
        hrp.CFrame = VoidHideSavedCFrame
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    if hrp then hrp.Anchored = false end
    VoidHideSavedCFrame = nil
end

local function VoidHideStartSpam()
    if VoidHideSpamConnection then return end
    VoidHideLastTeleport = 0
    VoidHideSpamConnection = RunService.Heartbeat:Connect(function()
        if Killed then return end
        local now = tick()
        if now - VoidHideLastTeleport >= VOID_SPAM_INTERVAL then
            VoidHideLastTeleport = now
            VoidHideTeleport()
        end
    end)
end

local function VoidHideStopSpam()
    if VoidHideSpamConnection then
        VoidHideSpamConnection:Disconnect()
        VoidHideSpamConnection = nil
    end
end

