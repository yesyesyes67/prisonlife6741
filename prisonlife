-- ============================================================
-- Prison Life noclip bypass
-- ============================================================
-- Prison Life runs a server-side collision re-apply loop whose
-- source identifier contains "CharacterCollision". It resets
-- CanCollide = true on every character part each physics step,
-- which defeats a plain client-side noclip loop. Two layers:
--   1. hookfunction the checker to a no-op closure at load.
--   2. collision-group fallback for executors that block
--      getgc/hookfunction — the checker does not audit
--      CollisionGroup, so this sidesteps it entirely.
-- ============================================================

local NOCLIP_GROUP = "noclip_grp"

pcall(function()
    PhysicsService:RegisterCollisionGroup(NOCLIP_GROUP)
end)
pcall(function()
    PhysicsService:CollisionGroupSetCollidable(NOCLIP_GROUP, "Default", false)
end)

local NoclipHookInstalled = false
pcall(function()
    local noop = newcclosure(function() return end)
    for _, obj in ipairs(getgc(false)) do
        if typeof(obj) == "function" then
            local ok, source = pcall(debug.info, obj, "s")
            if ok and source and source:find("CharacterCollision") then
                pcall(hookfunction, obj, noop)
                NoclipHookInstalled = true
            end
        end
    end
end)

local function ApplyNoclipToCharacter(char)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            pcall(function() part.CollisionGroup = NOCLIP_GROUP end)
        end
    end
end

