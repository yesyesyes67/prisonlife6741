local Utils = {}
Utils.hascharacter = function(plr)
    return plr and plr.Character
        and plr.Character:FindFirstChild("Humanoid")
        and plr.Character:FindFirstChild("HumanoidRootPart")
end
Utils.getping = function()
    local ok, val = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return ok and val or 0
end
Utils.isplayerbehindwall = function(plr)
    if not Utils.hascharacter(plr) or not Utils.hascharacter(LocalPlayer) then return true end
    local cam = ws.CurrentCamera
    if not cam then return true end
    local targetHead = plr.Character:FindFirstChild("Head")
    local targetHrp = plr.Character:FindFirstChild("HumanoidRootPart")
    local targetPos = targetHead and targetHead.Position or (targetHrp and targetHrp.Position)
    if not targetPos then return true end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LocalPlayer.Character}
    local hit = ws:Raycast(cam.CFrame.Position, targetPos - cam.CFrame.Position, rp)
    if hit and hit.Instance and not hit.Instance:IsDescendantOf(plr.Character) then
        return true
    end
    return false
end

local DaHood = {}
DaHood.isknocked = function(plr)
    if not Utils.hascharacter(plr) then return false end
    local char = plr.Character
    if char:GetAttribute("Knocked") then return true end
    local be = char:FindFirstChild("BodyEffects")
    if be and be:FindFirstChild("K.O") and be["K.O"].Value then return true end
    return false
end
DaHood.isdead = function(plr)
    if not (plr and plr.Character) then return true end
    local char = plr.Character
    if char:GetAttribute("Dead") then return true end
    local hum = char:FindFirstChild("Humanoid")
    return hum and hum.Health <= 0
end
DaHood.getarmor = function(plr)
    if not Utils.hascharacter(plr) then return 100 end
    local char = plr.Character
    for k, v in pairs(char:GetAttributes()) do
        if string.lower(k):find("armor") then return v end
    end
    local be = char:FindFirstChild("BodyEffects")
    if be and be:FindFirstChild("Armor") and be.Armor:IsA("NumberValue") then
        return be.Armor.Value
    end
    return 100
end

