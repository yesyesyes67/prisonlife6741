local AntiFlingEnabled = true

local function antiFlingPlayer(player)
    if Killed then return end
    if not player or player == LocalPlayer then return end
    pcall(function()
        player.CharacterAppearanceLoaded:Wait()
        if Killed or not AntiFlingEnabled then return end
        local char = player.Character
        if not char then return end
        for _, child in pairs(char:GetChildren()) do
            if child:IsA("BasePart") then
                child.CanCollide = false
                if child.Name == "Torso" then
                    child.Massless = true
                end
                local vector = Vector3.new()
                child.Velocity = vector
                child.RotVelocity = vector
            end
        end
    end)
end

local function antiFlingRunAll()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            task.spawn(antiFlingPlayer, player)
        end
    end
end

