local function MakeSeg(parent)
    local f = Instance.new("Frame")
    f.BorderSizePixel = 0
    f.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    f.Parent = parent
    return f
end

local function SetHSeg(f, x, y, w, color, thickness)
    f.AnchorPoint = Vector2.new(0, 0)
    f.Position = UDim2.fromOffset(x, y)
    f.Size = UDim2.fromOffset(w, thickness)
    f.BackgroundColor3 = color
    f.Visible = true
end

local function SetVSeg(f, x, y, h, color, thickness)
    f.AnchorPoint = Vector2.new(0, 0)
    f.Position = UDim2.fromOffset(x, y)
    f.Size = UDim2.fromOffset(thickness, h)
    f.BackgroundColor3 = color
    f.Visible = true
end

local function MakeLine(parent)
    local f = Instance.new("Frame")
    f.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    f.BorderSizePixel = 0
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Parent = parent
    return f
end

local function SetLine(line, x1, y1, x2, y2, color, thickness)
    local dx, dy = x2 - x1, y2 - y1
    local length = math.sqrt(dx * dx + dy * dy)
    local angle = math.atan2(dy, dx)
    local size = thickness or 2
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
    line.Size = UDim2.fromOffset(length, size)
    line.Rotation = math.deg(angle)
    line.BackgroundColor3 = color
    line.Visible = true
end

